@model MedicineFormViewModel
<partial name="_ModalHeader" model="@(Model.IsEdit ? "Edit medicine" : "Add medicine")" />

<form hx-post="@Url.Action("Save")" hx-target="#aq-modal-content" hx-swap="innerHTML" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="modal-body">
        <partial name="_ValidationSummary" />

        @if (Model.IsEdit)
        {
            <div class="alert alert-light border py-2 px-3 small mb-3">
                <i class="bi bi-info-circle me-1"></i>
                Stock level and average cost are maintained by purchases and treatments.
            </div>
        }

        <div class="row g-3">
            <div class="col-md-7">
                <label asp-for="Name" class="form-label">Medicine name <span class="req">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="Oxytetracycline" autofocus />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Brand" class="form-label"></label>
                <input asp-for="Brand" class="form-control" />
            </div>

            <div class="col-md-4">
                <label asp-for="MedicineType" class="form-label"></label>
                <select asp-for="MedicineType" class="form-select"
                        asp-items="Html.GetEnumSelectList<MedicineType>()"></select>
            </div>
            <div class="col-md-4">
                <label asp-for="Unit" class="form-label"></label>
                <select asp-for="Unit" class="form-select" asp-items="Html.GetEnumSelectList<UnitOfMeasure>()"></select>
            </div>
            <div class="col-md-4">
                <label asp-for="ExpiryDate" class="form-label"></label>
                <input asp-for="ExpiryDate" class="form-control" type="date" />
                <div class="form-text">Alerts fire 30 days before.</div>
            </div>

            <div class="col-md-7">
                <label asp-for="SupplierId" class="form-label"></label>
                <select asp-for="SupplierId" class="form-select">
                    <option value="">No default supplier</option>
                    @foreach (var supplier in Model.Suppliers)
                    {
                        <option value="@supplier.Id" selected="@(Model.SupplierId == supplier.Id)">@supplier.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label asp-for="ReorderLevel" class="form-label"></label>
                <input asp-for="ReorderLevel" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="ReorderLevel" class="field-validation-error"></span>
            </div>

            <div class="col-12">
                <label asp-for="Dosage" class="form-label"></label>
                <input asp-for="Dosage" class="form-control" placeholder="5 g per kg feed for 5 days" />
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>
    </div>

    <partial name="_ModalFooter" model="@(Model.IsEdit ? "Save changes" : "Add medicine")" />
</form>
