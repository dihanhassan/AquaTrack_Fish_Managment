@inject INotificationService Notifications
@{
    var unread = User.Identity?.IsAuthenticated == true ? await Notifications.GetUnreadCountAsync() : 0;
    var displayName = User.Identity?.Name ?? "User";
    var role = User.IsInRole(Roles.Admin) ? "Admin"
        : User.IsInRole(Roles.Manager) ? "Manager"
        : User.IsInRole(Roles.Worker) ? "Worker" : "User";
}
<div class="d-flex align-items-center gap-2">
    <span class="aq-busy spinner-border spinner-border-sm text-secondary" role="status" aria-hidden="true"></span>

    @* Polls quietly so a new alert appears without the user refreshing. *@
    <div class="dropdown"
         hx-get="@Url.Action("Bell", "Notifications")"
         hx-trigger="every 90s"
         hx-swap="outerHTML"
         hx-target="this">
        <button class="btn btn-icon position-relative" type="button" data-bs-toggle="dropdown"
                data-bs-auto-close="outside" aria-label="Notifications"
                hx-get="@Url.Action("Panel", "Notifications")"
                hx-target="#aq-notification-panel"
                hx-trigger="click">
            <i class="bi bi-bell fs-5"></i>
            @if (unread > 0)
            {
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                      style="font-size:.6rem">@(unread > 99 ? "99+" : unread.ToString())</span>
            }
        </button>
        <div class="dropdown-menu dropdown-menu-end p-0" style="width:340px" id="aq-notification-panel">
            <div class="p-3 text-center text-muted-2 small">Loading...</div>
        </div>
    </div>

    <div class="dropdown">
        <button class="btn btn-icon d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
            <span class="d-none d-md-block text-end lh-1">
                <span class="d-block fw-semibold" style="font-size:.82rem">@displayName</span>
                <span class="d-block text-faint" style="font-size:.7rem">@role</span>
            </span>
            <i class="bi bi-person-circle fs-4"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                    <i class="bi bi-person me-2"></i>My profile
                </a>
            </li>
            <li>
                <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                    <i class="bi bi-key me-2"></i>Change password
                </a>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i>Sign out
                    </button>
                </form>
            </li>
        </ul>
    </div>
</div>
