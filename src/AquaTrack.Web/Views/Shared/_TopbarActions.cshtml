@inject INotificationService Notifications
@{
    var displayName = User.Identity?.Name ?? "User";
    var role = User.IsInRole(Roles.Admin) ? "Admin"
        : User.IsInRole(Roles.Manager) ? "Manager"
        : User.IsInRole(Roles.Worker) ? "Worker" : "User";

    // The bell partial reads this, and is re-rendered on its own by the poll.
    ViewData["UnreadCount"] = User.Identity?.IsAuthenticated == true
        ? await Notifications.GetUnreadCountAsync()
        : 0;
}
<div class="d-flex align-items-center gap-2">
    <span class="aq-busy spinner-border spinner-border-sm text-secondary" role="status" aria-hidden="true"></span>

    <partial name="/Views/Notifications/_Bell.cshtml" />

    <div class="dropdown">
        <button class="btn btn-icon d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
            <span class="d-none d-md-block text-end lh-1">
                <span class="d-block fw-semibold" style="font-size:.82rem">@displayName</span>
                <span class="d-block text-faint" style="font-size:.7rem">@role</span>
            </span>
            <i class="bi bi-person-circle fs-4"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                    <i class="bi bi-person me-2"></i>My profile
                </a>
            </li>
            <li>
                <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                    <i class="bi bi-key me-2"></i>Change password
                </a>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i>Sign out
                    </button>
                </form>
            </li>
        </ul>
    </div>
</div>
