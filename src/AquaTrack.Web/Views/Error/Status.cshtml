@model StatusErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="aq-card">
    <div class="aq-card-body text-center py-5">
        <div style="font-size:2.6rem" class="text-muted-2 mb-2">
            <i class="bi @(Model.StatusCode == 404 ? "bi-compass" : "bi-exclamation-triangle")"></i>
        </div>
        <div class="aq-stat-label">Error @Model.StatusCode</div>
        <h2 class="h5 mt-1">@Model.Title</h2>
        <p class="text-muted-2 mb-4">@Model.Message</p>

        <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-house me-1"></i>Back to dashboard
        </a>
    </div>
</div>
