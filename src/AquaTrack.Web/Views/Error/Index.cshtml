@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : null;
}
@if (Layout is null)
{
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Something went wrong &middot; AquaTrack</title>
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    </head>
    <body>
        <div class="aq-auth">
            <div class="aq-auth-card text-center">
                <div style="font-size:2.4rem" class="text-warning mb-2">&#9888;</div>
                <h1 class="h5">Something went wrong</h1>
                <p class="text-muted-2 small">
                    The problem has been logged. Please try again.
                </p>
                @if (Model.ShowRequestId)
                {
                    <p class="text-faint" style="font-size:.74rem">Reference: @Model.RequestId</p>
                }
                <a class="btn btn-primary btn-sm" asp-controller="Dashboard" asp-action="Index">Back to the app</a>
            </div>
        </div>
    </body>
    </html>
}
else
{
    <div class="aq-card">
        <div class="aq-card-body text-center py-5">
            <div style="font-size:2.6rem" class="text-warning mb-2"><i class="bi bi-exclamation-triangle"></i></div>
            <h2 class="h5">Something went wrong</h2>
            <p class="text-muted-2 mb-1">
                The problem has been logged. Please try again, or go back to the dashboard.
            </p>
            @if (Model.ShowRequestId)
            {
                <p class="text-faint" style="font-size:.76rem">
                    Reference: <code>@Model.RequestId</code>
                </p>
            }
            <a class="btn btn-primary mt-3" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-house me-1"></i>Back to dashboard
            </a>
        </div>
    </div>
}
