@model FishTypeFormViewModel
<partial name="_ModalHeader" model="@(Model.IsEdit ? "Edit species" : "Add species")" />

<form hx-post="@Url.Action("Save")" hx-target="#aq-modal-content" hx-swap="innerHTML" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="modal-body">
        <partial name="_ValidationSummary" />

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label">Species name <span class="req">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="Rui" autofocus />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="LocalName" class="form-label"></label>
                <input asp-for="LocalName" class="form-control" placeholder="রুই" />
            </div>

            <div class="col-12">
                <label asp-for="ScientificName" class="form-label"></label>
                <input asp-for="ScientificName" class="form-control" placeholder="Labeo rohita" />
            </div>

            <div class="col-12">
                <div class="aq-form-section">Growth profile</div>
                <p class="text-muted-2 small mt-n1">
                    These figures drive the harvest estimate and the daily feed recommendation.
                </p>
            </div>

            <div class="col-md-4">
                <label asp-for="TargetWeightGram" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="TargetWeightGram" class="form-control" type="number" step="1" min="1" />
                    <span class="input-group-text">g</span>
                </div>
                <span asp-validation-for="TargetWeightGram" class="field-validation-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="GrowOutDays" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="GrowOutDays" class="form-control" type="number" step="1" min="1" />
                    <span class="input-group-text">days</span>
                </div>
                <span asp-validation-for="GrowOutDays" class="field-validation-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="DefaultFeedRatePercent" class="form-label">Feed rate <span class="req">*</span></label>
                <div class="input-group">
                    <input asp-for="DefaultFeedRatePercent" class="form-control" type="number" step="0.1" min="0.1" />
                    <span class="input-group-text">%</span>
                </div>
                <div class="form-text">Percent of body weight per day.</div>
                <span asp-validation-for="DefaultFeedRatePercent" class="field-validation-error"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </div>

    <partial name="_ModalFooter" model="@(Model.IsEdit ? "Save changes" : "Add species")" />
</form>
