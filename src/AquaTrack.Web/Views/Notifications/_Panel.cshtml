@model IReadOnlyList<Notification>
@{
    Func<NotificationSeverity, string> tone = severity => severity switch
    {
        NotificationSeverity.Critical => "danger",
        NotificationSeverity.Warning => "warning",
        NotificationSeverity.Success => "success",
        _ => "info",
    };

    Func<NotificationSeverity, string> icon = severity => severity switch
    {
        NotificationSeverity.Critical => "bi-exclamation-octagon-fill",
        NotificationSeverity.Warning => "bi-exclamation-triangle-fill",
        NotificationSeverity.Success => "bi-check-circle-fill",
        _ => "bi-info-circle-fill",
    };
}
<div class="px-3 py-2 border-bottom d-flex align-items-center">
    <strong style="font-size:.85rem">Alerts</strong>
    <a class="ms-auto small" asp-controller="Notifications" asp-action="Index">View all</a>
</div>

@if (Model.Count == 0)
{
    <div class="p-4 text-center text-muted-2 small">
        <i class="bi bi-check2-circle d-block mb-2" style="font-size:1.6rem;opacity:.4"></i>
        Nothing needs your attention.
    </div>
}
else
{
    <div style="max-height:340px;overflow-y:auto">
        @foreach (var alert in Model)
        {
            <div class="px-3 py-2 border-bottom d-flex gap-2 @(alert.IsRead ? "opacity-75" : "")">
                <i class="bi @icon(alert.Severity) text-@tone(alert.Severity) mt-1"></i>
                <div style="min-width:0" class="flex-grow-1">
                    <div class="fw-semibold" style="font-size:.8rem">@alert.Title</div>
                    <div class="text-muted-2" style="font-size:.75rem">@alert.Message</div>
                    <div class="text-faint" style="font-size:.7rem">
                        @alert.RaisedAtUtc.ToLocalTime().ToString("dd MMM, HH:mm")
                    </div>
                </div>
                @if (!alert.IsRead)
                {
                    <button type="button" class="btn btn-icon" title="Mark as read"
                            hx-post="@Url.Action("MarkRead", new { id = alert.Id })"
                            hx-target="#aq-notification-panel"
                            hx-swap="none">
                        <i class="bi bi-check2"></i>
                    </button>
                }
            </div>
        }
    </div>

    <div class="px-3 py-2">
        <button type="button" class="btn btn-outline-secondary btn-sm w-100"
                hx-post="@Url.Action("MarkAllRead")" hx-swap="none">
            Mark all as read
        </button>
    </div>
}
