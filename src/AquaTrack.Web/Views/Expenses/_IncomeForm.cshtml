@model OtherIncomeFormViewModel
<partial name="_ModalHeader" model="@("Record other income")" />

<form hx-post="@Url.Action("SaveIncome")" hx-target="#aq-modal-content" hx-swap="innerHTML" novalidate>
    @Html.AntiForgeryToken()

    <div class="modal-body">
        <partial name="_ValidationSummary" />

        <p class="text-muted-2 small">
            For money coming in that is not a fish sale: pond lease, scrap, a subsidy, and so on.
            Fish sales belong under Sales so the stock is reduced too.
        </p>

        <div class="row g-3">
            <div class="col-md-7">
                <label asp-for="Source" class="form-label">Source <span class="req">*</span></label>
                <input asp-for="Source" class="form-control" placeholder="Pond lease" autofocus />
                <span asp-validation-for="Source" class="field-validation-error"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="IncomeDate" class="form-label"></label>
                <input asp-for="IncomeDate" class="form-control" type="date"
                       max="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
                <span asp-validation-for="IncomeDate" class="field-validation-error"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Amount" class="form-label">Amount <span class="req">*</span></label>
                <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="Amount" class="field-validation-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="PaymentMethod" class="form-label"></label>
                <select asp-for="PaymentMethod" class="form-select"
                        asp-items="Html.GetEnumSelectList<PaymentMethod>()"></select>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" />
            </div>
        </div>
    </div>

    <partial name="_ModalFooter" model="@("Record income")" />
</form>
