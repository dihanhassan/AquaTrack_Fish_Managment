@model WaterQualityListViewModel
@{
    ViewData["Title"] = "Water Quality";
}
<div class="aq-card">
    <div class="aq-filters">
        <div>
            <label class="form-label">Pond</label>
            <select name="pondId" class="form-select form-select-sm"
                    hx-get="@Url.Action("List")" hx-target="#aq-water-table" hx-swap="outerHTML"
                    hx-push-url="true">
                <option value="">All ponds</option>
                @foreach (var pond in Model.Ponds)
                {
                    <option value="@pond.Id" selected="@(Model.PondId == pond.Id)">@pond.Name</option>
                }
            </select>
        </div>

        <div class="text-muted-2 small ms-2 mb-1">
            Safe bands: pH @WaterQualityRanges.Ph.Min&ndash;@WaterQualityRanges.Ph.Max,
            DO above @WaterQualityRanges.DissolvedOxygen.Min mg/L,
            ammonia below @WaterQualityRanges.Ammonia.Max mg/L.
        </div>

        <div class="ms-auto">
            <button type="button" class="btn btn-primary btn-sm"
                    hx-get="@Url.Action("Form", new { pondId = Model.PondId })" hx-target="#aq-modal-content">
                <i class="bi bi-plus-lg me-1"></i>Record reading
            </button>
        </div>
    </div>

    <partial name="_Table" model="Model" />
</div>
