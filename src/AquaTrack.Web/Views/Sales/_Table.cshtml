@model SaleListViewModel
@{
    var listUrl = Url.Action("List")!;
    var routeValues = Model.RouteValues();

    Func<string, string, string, SortHeaderViewModel> header = (label, key, align) => new SortHeaderViewModel
    {
        Label = label, Key = key, Align = align,
        Url = listUrl, Target = "#aq-sale-table",
        CurrentSort = Model.Query.Sort, CurrentDesc = Model.Query.Desc,
        RouteValues = routeValues,
    };
}
<div id="aq-sale-table"
     hx-get="@listUrl?@string.Join("&", routeValues.Where(v => v.Value != null).Select(v => $"{v.Key}={v.Value}"))"
     hx-trigger="aquatrack:refresh from:body"
     hx-swap="outerHTML">

    @if (Model.Page.TotalCount == 0)
    {
        <partial name="_EmptyState" model="@(string.IsNullOrWhiteSpace(Model.Query.Search) && !Model.OnlyWithDues
            ? new EmptyStateViewModel {
                Icon = "bi-receipt",
                Title = "No sales yet",
                Message = "Record a sale to track revenue, customer dues and what left each pond.",
                ActionLabel = "New sale",
                ActionUrl = Url.Action("Form") }
            : EmptyStateViewModel.NoMatches(Model.Query.Search))" />
    }
    else
    {
        <div class="aq-table-wrap">
            <table class="table aq-table">
                <thead>
                    <tr>
                        <partial name="_SortHeader" model="@header("Date", "date", "start")" />
                        <partial name="_SortHeader" model="@header("Invoice", "invoice", "start")" />
                        <partial name="_SortHeader" model="@header("Customer", "customer", "start")" />
                        <th>Fish</th>
                        <th class="text-end">Qty</th>
                        <partial name="_SortHeader" model="@header("Total", "total", "end")" />
                        <th class="text-end">Paid</th>
                        <th class="text-end">Due</th>
                        <th class="aq-row-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sale in Model.Page.Items)
                    {
                        <tr>
                            <td>@sale.SaleDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <a class="fw-semibold" asp-action="Details" asp-route-id="@sale.Id">@sale.InvoiceNo</a>
                            </td>
                            <td>@(sale.Customer?.Name ?? "Walk-in")</td>
                            <td class="text-muted-2" style="font-size:.8rem">
                                @string.Join(", ", sale.Items.Select(i => i.FishType?.Name ?? "-").Distinct())
                            </td>
                            <td class="num">@sale.Items.Sum(i => i.QuantityKg).ToString("N2") kg</td>
                            <td class="num fw-semibold">@sale.GrandTotal.ToString("N2")</td>
                            <td class="num">@sale.PaidAmount.ToString("N2")</td>
                            <td class="num @(sale.DueAmount > 0 ? "text-danger fw-semibold" : "")">
                                @sale.DueAmount.ToString("N2")
                            </td>
                            <td class="aq-row-actions">
                                @if (sale.DueAmount > 0)
                                {
                                    <button type="button" class="btn btn-icon" title="Receive payment"
                                            hx-get="@Url.Action("PaymentForm", new { id = sale.Id })"
                                            hx-target="#aq-modal-content">
                                        <i class="bi bi-cash-coin"></i>
                                    </button>
                                }
                                <a class="btn btn-icon" asp-action="Details" asp-route-id="@sale.Id" title="Open">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                                <button type="button" class="btn btn-icon danger" title="Delete"
                                        hx-get="@Url.Action("ConfirmDelete", new { id = sale.Id })"
                                        hx-target="#aq-modal-content">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4">Page total</td>
                        <td class="num">@Model.PageQuantityKg.ToString("N2") kg</td>
                        <td class="num">@Model.PageTotal.ToString("N2")</td>
                        <td class="num">@Model.PagePaid.ToString("N2")</td>
                        <td class="num">@Model.PageDue.ToString("N2")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <partial name="_Pager" model="@PagerViewModel.From(Model.Page, listUrl, "#aq-sale-table", routeValues)" />
    }
</div>
