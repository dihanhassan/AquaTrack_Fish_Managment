@model FeedListViewModel
@{
    ViewData["Title"] = "Feed";
    var canManage = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager);
    var canRecord = canManage || User.IsInRole(Roles.Worker);
}
<div class="aq-card">
    <div class="aq-filters">
        <div class="flex-grow-1" style="max-width:300px">
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="search" name="search" class="form-control" value="@Model.Query.Search"
                       placeholder="Search feed name or brand"
                       hx-get="@Url.Action("List")"
                       hx-target="#aq-feed-table"
                       hx-swap="outerHTML"
                       hx-trigger="input changed delay:350ms, search"
                       hx-include="[name=low]"
                       hx-push-url="true" />
            </div>
        </div>

        <div class="form-check mb-1">
            <input type="checkbox" name="low" value="true" class="form-check-input" id="low-filter"
                   checked="@Model.OnlyLowStock"
                   hx-get="@Url.Action("List")"
                   hx-target="#aq-feed-table"
                   hx-swap="outerHTML"
                   hx-include="[name=search]"
                   hx-push-url="true" />
            <label class="form-check-label small" for="low-filter">Low stock only</label>
        </div>

        <div class="ms-auto d-flex gap-2">
            @if (canRecord)
            {
                <button type="button" class="btn btn-outline-primary btn-sm"
                        hx-get="@Url.Action("UsageForm")" hx-target="#aq-modal-content">
                    <i class="bi bi-arrow-down-circle me-1"></i>Record feeding
                </button>
            }
            @if (canManage)
            {
                <button type="button" class="btn btn-outline-primary btn-sm"
                        hx-get="@Url.Action("PurchaseForm")" hx-target="#aq-modal-content">
                    <i class="bi bi-cart-plus me-1"></i>Record purchase
                </button>
                <button type="button" class="btn btn-primary btn-sm"
                        hx-get="@Url.Action("Form")" hx-target="#aq-modal-content">
                    <i class="bi bi-plus-lg me-1"></i>Add feed item
                </button>
            }
        </div>
    </div>

    <partial name="_Table" model="Model" />
</div>
