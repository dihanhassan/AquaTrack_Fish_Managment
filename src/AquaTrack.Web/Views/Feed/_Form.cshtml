@model FeedItemFormViewModel
<partial name="_ModalHeader" model="@(Model.IsEdit ? "Edit feed item" : "Add feed item")" />

<form hx-post="@Url.Action("Save")" hx-target="#aq-modal-content" hx-swap="innerHTML" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="modal-body">
        <partial name="_ValidationSummary" />

        @if (Model.IsEdit)
        {
            <div class="alert alert-light border py-2 px-3 small mb-3">
                <i class="bi bi-info-circle me-1"></i>
                Stock level and average cost are maintained by purchases and feeding, so they are
                not edited here.
            </div>
        }

        <div class="row g-3">
            <div class="col-md-7">
                <label asp-for="Name" class="form-label">Feed name <span class="req">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="Floating Feed (Grower)" autofocus />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Brand" class="form-label"></label>
                <input asp-for="Brand" class="form-control" placeholder="Mega Fish" />
            </div>

            <div class="col-md-4">
                <label asp-for="FeedType" class="form-label"></label>
                <select asp-for="FeedType" class="form-select" asp-items="Html.GetEnumSelectList<FeedType>()"></select>
            </div>
            <div class="col-md-4">
                <label asp-for="Unit" class="form-label"></label>
                <select asp-for="Unit" class="form-select" asp-items="Html.GetEnumSelectList<UnitOfMeasure>()"></select>
            </div>
            <div class="col-md-4">
                <label asp-for="ProteinPercent" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="ProteinPercent" class="form-control" type="number" step="0.1" min="0" max="100" />
                    <span class="input-group-text">%</span>
                </div>
                <span asp-validation-for="ProteinPercent" class="field-validation-error"></span>
            </div>

            <div class="col-md-7">
                <label asp-for="SupplierId" class="form-label"></label>
                <select asp-for="SupplierId" class="form-select">
                    <option value="">No default supplier</option>
                    @foreach (var supplier in Model.Suppliers)
                    {
                        <option value="@supplier.Id" selected="@(Model.SupplierId == supplier.Id)">@supplier.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label asp-for="ReorderLevel" class="form-label"></label>
                <input asp-for="ReorderLevel" class="form-control" type="number" step="0.01" min="0" />
                <div class="form-text">An alert is raised at or below this level.</div>
                <span asp-validation-for="ReorderLevel" class="field-validation-error"></span>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>
    </div>

    <partial name="_ModalFooter" model="@(Model.IsEdit ? "Save changes" : "Add feed item")" />
</form>
