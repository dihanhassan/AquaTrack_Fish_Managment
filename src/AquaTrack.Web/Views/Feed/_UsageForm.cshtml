@model FeedUsageFormViewModel
<partial name="_ModalHeader" model="@("Record feeding")" />

<form hx-post="@Url.Action("SaveUsage")" hx-target="#aq-modal-content" hx-swap="innerHTML" novalidate>
    @Html.AntiForgeryToken()

    <div class="modal-body">
        <partial name="_ValidationSummary" />

        <p class="text-muted-2 small">
            This takes feed out of store and costs it to the pond at the current average cost.
        </p>

        <div class="row g-3">
            <div class="col-md-7">
                <label asp-for="FeedItemId" class="form-label">Feed item <span class="req">*</span></label>
                <select asp-for="FeedItemId" class="form-select">
                    <option value="0">Choose a feed item</option>
                    @foreach (var item in Model.FeedItems)
                    {
                        <option value="@item.Id" selected="@(Model.FeedItemId == item.Id)">@item.Name</option>
                    }
                </select>
                <span asp-validation-for="FeedItemId" class="field-validation-error"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="UsageDate" class="form-label"></label>
                <input asp-for="UsageDate" class="form-control" type="date" />
            </div>

            <div class="col-md-7">
                <label asp-for="PondId" class="form-label">Pond <span class="req">*</span></label>
                <select asp-for="PondId" class="form-select">
                    <option value="0">Choose a pond</option>
                    @foreach (var pond in Model.Ponds)
                    {
                        <option value="@pond.Id" selected="@(Model.PondId == pond.Id)">@pond.Name</option>
                    }
                </select>
                <span asp-validation-for="PondId" class="field-validation-error"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Quantity" class="form-label">Quantity <span class="req">*</span></label>
                <input asp-for="Quantity" class="form-control" type="number" step="0.01" min="0.001" autofocus />
                <span asp-validation-for="Quantity" class="field-validation-error"></span>
            </div>

            <div class="col-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </div>

    <partial name="_ModalFooter" model="@("Record feeding")" />
</form>
