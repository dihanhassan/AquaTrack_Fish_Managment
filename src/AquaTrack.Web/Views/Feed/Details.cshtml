@model FeedDetailsViewModel
@{
    ViewData["Title"] = Model.Item.Name;
    var canManage = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager);
    var item = Model.Item;
}
<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">
        <i class="bi bi-arrow-left me-1"></i>All feed
    </a>
    @if (canManage)
    {
        <button type="button" class="btn btn-outline-primary btn-sm"
                hx-get="@Url.Action("PurchaseForm", new { feedItemId = item.Id })" hx-target="#aq-modal-content">
            <i class="bi bi-cart-plus me-1"></i>Record purchase
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm ms-auto"
                hx-get="@Url.Action("Form", new { id = item.Id })" hx-target="#aq-modal-content">
            <i class="bi bi-pencil me-1"></i>Edit
        </button>
    }
</div>

<div class="row g-3">
    <div class="col-6 col-lg-3">
        <partial name="_StatCard" model="@(new StatCardViewModel {
            Label = "In Stock", Value = item.CurrentStock.ToString("N2") + " " + item.Unit,
            Meta = "Reorder at " + item.ReorderLevel.ToString("N2"),
            Icon = "bi-basket",
            Tone = item.IsLowStock ? "warning" : "accent" })" />
    </div>
    <div class="col-6 col-lg-3">
        <partial name="_StatCard" model="@(new StatCardViewModel {
            Label = "Stock Value", Value = item.StockValue.ToString("N2"),
            Meta = "At " + item.AverageUnitCost.ToString("N2") + " average cost",
            Icon = "bi-cash", Tone = "primary" })" />
    </div>
    <div class="col-6 col-lg-3">
        <partial name="_StatCard" model="@(new StatCardViewModel {
            Label = "Purchased", Value = Model.TotalPurchased.ToString("N2"),
            Meta = "Cost " + Model.TotalPurchaseCost.ToString("N2"),
            Icon = "bi-cart", Tone = "primary" })" />
    </div>
    <div class="col-6 col-lg-3">
        <partial name="_StatCard" model="@(new StatCardViewModel {
            Label = "Fed Out", Value = Model.TotalUsed.ToString("N2"),
            Meta = "Cost " + Model.TotalUsageCost.ToString("N2"),
            Icon = "bi-arrow-down-circle", Tone = "success" })" />
    </div>
</div>

<div class="row g-3 mt-0">
    <div class="col-lg-6">
        <div class="aq-card h-100">
            <div class="aq-card-header"><h2 class="aq-card-title">Recent purchases</h2></div>
            @if (Model.Purchases.Count == 0)
            {
                <div class="aq-empty py-4"><div class="aq-empty-text">No purchases recorded.</div></div>
            }
            else
            {
                <div class="aq-table-wrap">
                    <table class="table aq-table">
                        <thead>
                            <tr>
                                <th>Date</th><th>Supplier</th>
                                <th class="text-end">Qty</th><th class="text-end">Unit</th>
                                <th class="text-end">Total</th><th class="text-end">Due</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var purchase in Model.Purchases)
                            {
                                <tr>
                                    <td>@purchase.PurchaseDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-muted-2">@(purchase.Supplier?.Name ?? "-")</td>
                                    <td class="num">@purchase.Quantity.ToString("N2")</td>
                                    <td class="num">@purchase.UnitPrice.ToString("N2")</td>
                                    <td class="num">@purchase.TotalPrice.ToString("N2")</td>
                                    <td class="num @(purchase.DueAmount > 0 ? "text-danger" : "")">
                                        @purchase.DueAmount.ToString("N2")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="aq-card h-100">
            <div class="aq-card-header"><h2 class="aq-card-title">Recent feeding</h2></div>
            @if (Model.Usages.Count == 0)
            {
                <div class="aq-empty py-4"><div class="aq-empty-text">No feeding recorded.</div></div>
            }
            else
            {
                <div class="aq-table-wrap">
                    <table class="table aq-table">
                        <thead>
                            <tr>
                                <th>Date</th><th>Pond</th>
                                <th class="text-end">Qty</th><th class="text-end">Unit cost</th>
                                <th class="text-end">Cost</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var usage in Model.Usages)
                            {
                                <tr>
                                    <td>@usage.UsageDate.ToString("dd MMM yyyy")</td>
                                    <td>@(usage.Pond?.Name ?? "-")</td>
                                    <td class="num">@usage.Quantity.ToString("N2")</td>
                                    <td class="num text-muted-2">@usage.UnitCost.ToString("N2")</td>
                                    <td class="num">@usage.TotalCost.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
