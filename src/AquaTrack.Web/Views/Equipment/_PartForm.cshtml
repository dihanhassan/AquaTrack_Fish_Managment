@model EquipmentPartFormViewModel
<partial name="_ModalHeader" model="@("Add spare part")" />

<form hx-post="@Url.Action("SavePart")" hx-target="#aq-modal-content" hx-swap="innerHTML" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="EquipmentId" />

    <div class="modal-body">
        <partial name="_ValidationSummary" />

        <div class="row g-3">
            <div class="col-md-7">
                <label asp-for="Name" class="form-label">Part name <span class="req">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="Impeller" autofocus />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="PartNo" class="form-label"></label>
                <input asp-for="PartNo" class="form-control" />
            </div>

            <div class="col-md-3">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="Quantity" class="field-validation-error"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Unit" class="form-label"></label>
                <select asp-for="Unit" class="form-select" asp-items="Html.GetEnumSelectList<UnitOfMeasure>()"></select>
            </div>
            <div class="col-md-3">
                <label asp-for="ReorderLevel" class="form-label"></label>
                <input asp-for="ReorderLevel" class="form-control" type="number" step="0.01" min="0" />
            </div>
            <div class="col-md-3">
                <label asp-for="UnitPrice" class="form-label"></label>
                <input asp-for="UnitPrice" class="form-control" type="number" step="0.01" min="0" />
            </div>

            <div class="col-md-5">
                <label asp-for="PurchaseDate" class="form-label"></label>
                <input asp-for="PurchaseDate" class="form-control" type="date" />
            </div>
            <div class="col-md-7">
                <label asp-for="Notes" class="form-label"></label>
                <input asp-for="Notes" class="form-control" />
            </div>
        </div>
    </div>

    <partial name="_ModalFooter" model="@("Add part")" />
</form>
