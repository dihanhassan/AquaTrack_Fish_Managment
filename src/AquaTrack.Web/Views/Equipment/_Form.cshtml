@model EquipmentFormViewModel
<partial name="_ModalHeader" model="@(Model.IsEdit ? "Edit equipment" : "Add equipment")" />

<form hx-post="@Url.Action("Save")" hx-target="#aq-modal-content" hx-swap="innerHTML" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="modal-body">
        <partial name="_ValidationSummary" />

        <div class="row g-3">
            <div class="col-md-7">
                <label asp-for="Name" class="form-label">Equipment name <span class="req">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="Water Pump 5HP" autofocus />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" placeholder="EQ-01" />
            </div>

            <div class="col-md-4">
                <label asp-for="Category" class="form-label"></label>
                <select asp-for="Category" class="form-select"
                        asp-items="Html.GetEnumSelectList<EquipmentCategory>()"></select>
            </div>
            <div class="col-md-4">
                <label asp-for="Brand" class="form-label"></label>
                <input asp-for="Brand" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="ModelNo" class="form-label"></label>
                <input asp-for="ModelNo" class="form-control" />
            </div>

            <div class="col-12"><div class="aq-form-section">Purchase</div></div>

            <div class="col-md-4">
                <label asp-for="PurchaseDate" class="form-label"></label>
                <input asp-for="PurchaseDate" class="form-control" type="date" />
            </div>
            <div class="col-md-4">
                <label asp-for="PurchasePrice" class="form-label"></label>
                <input asp-for="PurchasePrice" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="PurchasePrice" class="field-validation-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" type="number" min="1" />
                <span asp-validation-for="Quantity" class="field-validation-error"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="SupplierId" class="form-label"></label>
                <select asp-for="SupplierId" class="form-select">
                    <option value="">Not recorded</option>
                    @foreach (var supplier in Model.Suppliers)
                    {
                        <option value="@supplier.Id" selected="@(Model.SupplierId == supplier.Id)">@supplier.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="SerialNo" class="form-label"></label>
                <input asp-for="SerialNo" class="form-control" />
            </div>

            <div class="col-12"><div class="aq-form-section">Status</div></div>

            <div class="col-md-4">
                <label asp-for="Condition" class="form-label"></label>
                <select asp-for="Condition" class="form-select"
                        asp-items="Html.GetEnumSelectList<EquipmentCondition>()"></select>
            </div>
            <div class="col-md-4">
                <label asp-for="WarrantyUntil" class="form-label"></label>
                <input asp-for="WarrantyUntil" class="form-control" type="date" />
            </div>
            <div class="col-md-4">
                <label asp-for="PondId" class="form-label"></label>
                <select asp-for="PondId" class="form-select">
                    <option value="">Not assigned</option>
                    @foreach (var pond in Model.Ponds)
                    {
                        <option value="@pond.Id" selected="@(Model.PondId == pond.Id)">@pond.Name</option>
                    }
                </select>
            </div>

            <div class="col-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </div>

    <partial name="_ModalFooter" model="@(Model.IsEdit ? "Save changes" : "Add equipment")" />
</form>
