@model GrowthFormViewModel
<partial name="_ModalHeader" model="@("Record growth sample")" />

<form hx-post="@Url.Action("SaveGrowth")" hx-target="#aq-modal-content" hx-swap="innerHTML" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="FishStockId" />

    <div class="modal-body">
        <partial name="_ValidationSummary" />

        <p class="text-muted-2 small">
            Net a handful of fish, weigh them together, and enter the average. This drives the
            growth chart and the feed recommendation.
        </p>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="RecordDate" class="form-label"></label>
                <input asp-for="RecordDate" class="form-control" type="date" />
            </div>
            <div class="col-md-6">
                <label asp-for="SampleSize" class="form-label">Sample size <span class="req">*</span></label>
                <div class="input-group">
                    <input asp-for="SampleSize" class="form-control" type="number" min="1" />
                    <span class="input-group-text">fish</span>
                </div>
                <span asp-validation-for="SampleSize" class="field-validation-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="AvgWeightGram" class="form-label">Average weight <span class="req">*</span></label>
                <div class="input-group">
                    <input asp-for="AvgWeightGram" class="form-control" type="number" step="0.1" min="0.01" autofocus />
                    <span class="input-group-text">g</span>
                </div>
                <span asp-validation-for="AvgWeightGram" class="field-validation-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="AvgLengthCm" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="AvgLengthCm" class="form-control" type="number" step="0.1" min="0" />
                    <span class="input-group-text">cm</span>
                </div>
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </div>

    <partial name="_ModalFooter" model="@("Record sample")" />
</form>
