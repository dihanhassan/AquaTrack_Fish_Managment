@model FishStockFormViewModel
<partial name="_ModalHeader" model="@(Model.IsEdit ? "Edit batch" : "Stock a batch")" />

<form hx-post="@Url.Action("Save")" hx-target="#aq-modal-content" hx-swap="innerHTML" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="modal-body">
        <partial name="_ValidationSummary" />

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="PondId" class="form-label">Pond <span class="req">*</span></label>
                <select asp-for="PondId" class="form-select">
                    <option value="0">Choose a pond</option>
                    @foreach (var pond in Model.Ponds)
                    {
                        <option value="@pond.Id" selected="@(Model.PondId == pond.Id)">@pond.Name</option>
                    }
                </select>
                <span asp-validation-for="PondId" class="field-validation-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="FishTypeId" class="form-label">Species <span class="req">*</span></label>
                <select asp-for="FishTypeId" class="form-select">
                    <option value="0">Choose a species</option>
                    @foreach (var species in Model.Species)
                    {
                        <option value="@species.Id" selected="@(Model.FishTypeId == species.Id)">@species.Name</option>
                    }
                </select>
                <span asp-validation-for="FishTypeId" class="field-validation-error"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="BatchCode" class="form-label"></label>
                <input asp-for="BatchCode" class="form-control" placeholder="B-P01-RUI" />
            </div>
            <div class="col-md-6">
                <label asp-for="StockDate" class="form-label">Stocking date <span class="req">*</span></label>
                <input asp-for="StockDate" class="form-control" type="date" />
                <span asp-validation-for="StockDate" class="field-validation-error"></span>
            </div>

            <div class="col-12"><div class="aq-form-section">Quantity and cost</div></div>

            <div class="col-md-4">
                <label asp-for="InitialQuantity" class="form-label">Quantity <span class="req">*</span></label>
                <div class="input-group">
                    <input asp-for="InitialQuantity" class="form-control" type="number" min="1" data-qty />
                    <span class="input-group-text">pcs</span>
                </div>
                <span asp-validation-for="InitialQuantity" class="field-validation-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="InitialAvgWeightGram" class="form-label">Avg weight <span class="req">*</span></label>
                <div class="input-group">
                    <input asp-for="InitialAvgWeightGram" class="form-control" type="number" step="0.01" min="0.01" />
                    <span class="input-group-text">g</span>
                </div>
                <span asp-validation-for="InitialAvgWeightGram" class="field-validation-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="UnitCost" class="form-label">Cost per fish</label>
                <input asp-for="UnitCost" class="form-control" type="number" step="0.01" min="0" data-price />
                <span asp-validation-for="UnitCost" class="field-validation-error"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Source" class="form-label"></label>
                <input asp-for="Source" class="form-control" placeholder="Sonali Hatchery" />
            </div>
            <div class="col-md-6">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<StockStatus>()"></select>
            </div>

            <div class="col-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </div>

    <partial name="_ModalFooter" model="@(Model.IsEdit ? "Save changes" : "Stock batch")" />
</form>
